# ── Smart Study Reminder AI — Environment Configuration Template ──

# Application
APP_NAME="Smart Study Reminder AI"
APP_VERSION="1.0.0"
DEBUG=false

# Security & JWT
SECRET_KEY="dev-secret-key-change-in-production-32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./study_reminder.db"

# Google Gemini API Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
USE_GEMINI=true

# AI Service Mode: "gemini" | "local" | "remote"
AI_SERVICE_MODE=local
AI_SERVICE_URL="https://dub.aupcloud.io/aipc-14"
AI_SERVICE_TOKEN=""
AI_SERVICE_TIMEOUT=10.0

# CORS & Dev Mode
FRONTEND_URL="http://localhost:5173"
DEV_MODE=true

# SMTP Configuration (Optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Smart Study Reminder AI"
SMTP_FROM_EMAIL=""
