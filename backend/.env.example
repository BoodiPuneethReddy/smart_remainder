# Smart Study Reminder AI — Backend Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env — it is gitignored.

# ─── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_64_char_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./study_reminder.db

# ─── AI Service ───────────────────────────────────────────────────────────────
# Set to "local" for fully offline mode (no AMD dependency)
# Set to "remote" to use the AMD JupyterLab inference endpoint
AI_SERVICE_MODE=local

# AMD JupyterLab inference endpoint (only used when AI_SERVICE_MODE=remote)
AI_SERVICE_URL=https://dub.aupcloud.io/aipc-14

# Your team's private AMD access token — KEEP THIS SECRET, never commit
AI_SERVICE_TOKEN=your_amd_token_here

# ─── Scheduler ────────────────────────────────────────────────────────────────
# How often (seconds) the Reminder Agent polls for urgent tasks
REMINDER_POLL_INTERVAL=60

FRONTEND_URL=http://localhost:5173

# ─── Dev Mode & SMTP Configuration ────────────────────────────────────────────
DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
