# Smart Study Reminder AI — Environment Variables Template
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./study_ai.db

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Service ────────────────────────────────────────────────────────────────
# Set to "local" to use template-based AI (no external calls)
# Set to "remote" to use AMD JupyterLab endpoint
AI_SERVICE_MODE=local
AI_SERVICE_URL=https://your-amd-endpoint.example.com
AI_SERVICE_TOKEN=your-amd-api-token-here
AI_SERVICE_TIMEOUT=10.0

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
